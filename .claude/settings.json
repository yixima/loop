{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/verify.sh)",
      "Bash(./scripts/verify.sh:*)",
      "Bash(./scripts/gpt-review.sh)",
      "Bash(./scripts/gpt-review.sh:*)",
      "Bash(./scripts/loop.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m compileall:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(codex login status)",
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*credential*)",
      "Read(**/id_rsa*)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "env": {
    "_comment_GPT_REVIEW_MODEL": "レビューに使う OpenAI モデルを固定したい場合はここに GPT_REVIEW_MODEL を設定する。未設定なら Codex CLI の既定モデルを使う。"
  }
}
